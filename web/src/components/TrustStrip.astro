---
import { trustStrip } from '../data/site';
---

<div class="border-y border-ink/8 bg-white">
  <div class="container-wide px-5 py-4 sm:px-6 md:px-10 lg:px-16">
    <ul class="grid grid-cols-2 gap-x-4 gap-y-3 md:flex md:flex-wrap md:items-center md:justify-center md:gap-x-12">
      {
        trustStrip.map((item) => (
          <li class="flex items-start gap-2 text-[12px] leading-snug text-ink-muted sm:text-[13px] md:items-center md:gap-2.5">
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-gold md:mt-0" aria-hidden="true" />
            {item.label}
          </li>
        ))
      }
    </ul>
  </div>
</div>
