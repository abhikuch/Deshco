---
import { aboutContent } from '../data/site';
---

<section class="section-padding bg-white">
  <div class="container-wide">
    <div class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-xl">
        <p class="eyebrow mb-3">Leadership</p>
        <h2 class="heading-display text-3xl text-ink md:text-4xl">Meet the founders</h2>
        <p class="mt-3 text-[15px] text-ink-muted">
          Deshco is founder-managed — you work directly with the people accountable for your property.
        </p>
      </div>
      <a
        href="/about"
        class="text-[13px] font-medium tracking-wide text-gold-muted transition-colors hover:text-gold"
      >
        Read our story →
      </a>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      {
        aboutContent.founders.map((founder) => (
          <article class="flex gap-5 border border-ink/8 bg-cream p-5 md:gap-6 md:p-6">
            <img
              src={founder.image}
              alt={founder.name}
              class="h-20 w-20 shrink-0 rounded-full object-cover md:h-24 md:w-24"
              loading="lazy"
              width="96"
              height="96"
            />
            <div>
              <h3 class="heading-display text-xl text-ink">{founder.name}</h3>
              <p class="mb-2 text-sm text-ink-faint">{founder.role}</p>
              <p class="text-[14px] leading-relaxed text-ink-muted line-clamp-3">
                {founder.message.split('.')[0]}.
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
