---
interface Section {
  heading: string;
  content: string;
}

interface Props {
  title: string;
  sections: readonly Section[];
}

const { title, sections } = Astro.props;
---

<section class="bg-cream pt-32 pb-8">
  <div class="container-narrow">
    <p class="mb-3 text-xs font-medium tracking-[0.25em] text-gold uppercase">Legal</p>
    <h1 class="heading-display text-4xl md:text-5xl">{title}</h1>
  </div>
</section>

<section class="section-padding bg-white pt-12">
  <div class="container-narrow prose-policy space-y-10">
    {
      sections.map((section) => (
        <div>
          <h2 class="heading-display mb-4 text-2xl">{section.heading}</h2>
          <div class="space-y-4 leading-relaxed whitespace-pre-line text-ink-muted">
            {section.content}
          </div>
        </div>
      ))
    }
  </div>
</section>
