---
interface Props {
  size?: 'sm' | 'md';
}

const { size = 'md' } = Astro.props;

const heightClass = size === 'sm' ? 'h-11 max-w-[10.5rem] sm:h-12 md:h-12 md:max-w-none' : 'h-10 md:h-12';
---

<img
  src="/images/logo-header.png"
  alt="Deshco Holiday Homes"
  class:list={['w-auto object-contain', heightClass]}
  width="245"
  height="82"
  loading="eager"
  decoding="async"
/>
