---
interface Props {
  size?: 'sm' | 'md';
}

const { size = 'md' } = Astro.props;

const heightClass = size === 'sm' ? 'h-[3.25rem] max-w-[12rem] sm:h-14 md:max-w-none' : 'h-11 md:h-14';
---

<img
  src="/images/logo-header.png"
  alt="Deshco Holiday Homes"
  class:list={['w-auto object-contain', heightClass]}
  width="245"
  height="82"
  loading="eager"
  decoding="async"
/>
