---
import { siteConfig, navLinks } from '../data/site';
import BrandMark from './BrandMark.astro';
---

<header
  id="site-header"
  class="fixed top-0 right-0 left-0 z-[110] border-b border-transparent pt-[env(safe-area-inset-top)] backdrop-blur-sm transition-all duration-300"
  data-theme="dark"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5 sm:px-6 sm:py-4 md:px-10">
    <a href="/" class="relative z-[120]" aria-label="Deshco Holiday Homes">
      <BrandMark size="sm" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link text-[13px] font-medium tracking-wide transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <a
        href={siteConfig.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-cta inline-flex items-center rounded-sm border px-4 py-2 text-[13px] font-medium tracking-wide transition-colors"
      >
        Enquire
      </a>
    </div>

    <a
      href={siteConfig.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-menu-header-cta pointer-events-none absolute top-1/2 left-1/2 z-[120] hidden -translate-x-1/2 -translate-y-1/2 border border-gold-bright bg-gold-bright px-3 py-2 text-[11px] font-medium tracking-wide whitespace-nowrap text-ink opacity-0 transition-opacity duration-300 sm:px-4 sm:text-[12px] lg:hidden"
    >
      Enquire on WhatsApp
    </a>

    <button
      id="mobile-menu-btn"
      type="button"
      class="relative z-[120] flex h-10 w-10 items-center justify-center lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Menu</span>
      <div class="relative h-3.5 w-5">
        <span class="menu-line absolute top-0 left-0 block h-px w-5 transition-all duration-300"></span>
        <span class="menu-line absolute top-1.5 left-0 block h-px w-5 transition-all duration-300"></span>
        <span class="menu-line absolute top-3 left-0 block h-px w-5 transition-all duration-300"></span>
      </div>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="pointer-events-none invisible fixed inset-0 z-[100] bg-ink opacity-0 transition-[opacity,visibility] duration-300 lg:hidden"
  aria-hidden="true"
>
  <nav
    class="flex h-full flex-col gap-6 overflow-y-auto px-6 pt-24 pb-8"
    aria-label="Mobile navigation"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="font-display text-[1.65rem] leading-tight text-white transition-colors hover:text-gold-bright"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<script>
  const header = document.getElementById('site-header');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuLines = menuBtn?.querySelectorAll('.menu-line');
  let menuOpen = false;

  function isOverHero() {
    const hero = document.querySelector('[data-hero]');
    if (!hero) return window.scrollY <= 80;
    return hero.getBoundingClientRect().bottom > 72;
  }

  function setMenuOpen(open: boolean) {
    menuOpen = open;
    menuBtn?.setAttribute('aria-expanded', String(open));
    menuBtn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobileMenu?.classList.toggle('invisible', !open);
    mobileMenu?.classList.toggle('opacity-0', !open);
    mobileMenu?.classList.toggle('pointer-events-none', !open);
    mobileMenu?.setAttribute('aria-hidden', String(!open));
    document.body.classList.toggle('overflow-hidden', open);
    document.body.classList.toggle('mobile-menu-open', open);

    menuLines?.[0]?.classList.toggle('top-1.5', open);
    menuLines?.[0]?.classList.toggle('rotate-45', open);
    menuLines?.[1]?.classList.toggle('opacity-0', open);
    menuLines?.[2]?.classList.toggle('top-1.5', open);
    menuLines?.[2]?.classList.toggle('-rotate-45', open);

    window.dispatchEvent(new CustomEvent('mobile-menu-toggle', { detail: { open } }));

    if (!open) updateHeader();
  }

  function updateHeader() {
    if (!header || menuOpen) return;
    const onHero = isOverHero();
    header.dataset.theme = onHero ? 'dark' : 'light';
    header.classList.toggle('bg-cream/95', !onHero);
    header.classList.toggle('border-ink/8', !onHero);
    header.classList.toggle('shadow-sm', !onHero);
    header.classList.toggle('border-transparent', onHero);
  }

  function toggleMenu() {
    setMenuOpen(!menuOpen);
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  window.addEventListener('resize', updateHeader, { passive: true });
  updateHeader();
  menuBtn?.addEventListener('click', toggleMenu);

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menuOpen) setMenuOpen(false);
    });
  });
</script>

<style>
  :global(body.mobile-menu-open .mobile-menu-header-cta) {
    display: inline-flex;
    opacity: 1;
    pointer-events: auto;
  }
</style>
