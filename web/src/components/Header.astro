---
import { siteConfig, navLinks } from '../data/site';
import BrandMark from './BrandMark.astro';
---

<header
  id="site-header"
  class="fixed top-0 right-0 left-0 z-50 border-b border-transparent backdrop-blur-sm transition-all duration-300"
  data-theme="dark"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 md:px-10">
    <a href="/" class="relative z-10" aria-label="Deshco Holiday Homes">
      <BrandMark variant="light" size="sm" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link text-[13px] font-medium tracking-wide transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <a
        href={siteConfig.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-cta inline-flex items-center rounded-sm border px-4 py-2 text-[13px] font-medium tracking-wide transition-colors"
      >
        Enquire
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      type="button"
      class="relative z-10 flex h-9 w-9 items-center justify-center lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="sr-only">Menu</span>
      <div class="flex flex-col gap-1.5">
        <span class="menu-line block h-px w-5 transition-all"></span>
        <span class="menu-line block h-px w-5 transition-all"></span>
      </div>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-0 z-40 flex flex-col justify-center bg-ink/97 opacity-0 backdrop-blur-md transition-opacity duration-300 lg:hidden"
  >
    <nav class="flex flex-col items-center gap-7" aria-label="Mobile navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-display text-3xl font-normal text-white transition-colors hover:text-gold-bright"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={siteConfig.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 border border-gold-bright px-6 py-2.5 text-[13px] font-medium tracking-wide text-gold-bright"
      >
        Enquire
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  let menuOpen = false;

  function isOverHero() {
    const hero = document.querySelector('[data-hero]');
    if (!hero) return window.scrollY <= 80;
    return hero.getBoundingClientRect().bottom > 72;
  }

  function updateHeader() {
    if (!header || menuOpen) return;
    const onHero = isOverHero();
    header.dataset.theme = onHero ? 'dark' : 'light';
    header.classList.toggle('bg-cream/95', !onHero);
    header.classList.toggle('border-ink/8', !onHero);
    header.classList.toggle('shadow-sm', !onHero);
    header.classList.toggle('border-transparent', onHero);
  }

  function toggleMenu() {
    menuOpen = !menuOpen;
    menuBtn?.setAttribute('aria-expanded', String(menuOpen));
    mobileMenu?.classList.toggle('opacity-0', !menuOpen);
    mobileMenu?.classList.toggle('pointer-events-none', !menuOpen);
    document.body.style.overflow = menuOpen ? 'hidden' : '';
    if (!menuOpen) updateHeader();
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  window.addEventListener('resize', updateHeader, { passive: true });
  updateHeader();
  menuBtn?.addEventListener('click', toggleMenu);

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menuOpen) toggleMenu();
    });
  });
</script>
