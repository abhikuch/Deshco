---
import { siteConfig, navLinks } from '../data/site';
---

<header
  id="site-header"
  class="fixed top-0 right-0 left-0 z-50 transition-all duration-500"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 md:px-12">
    <a href="/" class="relative z-10 flex items-center gap-2.5" aria-label="Deshco Holiday Homes">
      <img
        src="/images/favicon.png"
        alt=""
        class="h-9 w-9 rounded-full"
        width="36"
        height="36"
        aria-hidden="true"
      />
      <span class="font-display text-xl font-medium tracking-tight text-white md:text-2xl">
        Deshco
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium tracking-wide text-white/80 transition-colors hover:text-white link-underline"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a
        href={siteConfig.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-white/30 px-5 py-2.5 text-sm font-medium text-white transition-all hover:border-white hover:bg-white/10"
      >
        Let's Connect
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      type="button"
      class="relative z-10 flex h-10 w-10 items-center justify-center lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="sr-only">Menu</span>
      <div class="flex flex-col gap-1.5">
        <span class="menu-line block h-0.5 w-6 bg-white transition-all"></span>
        <span class="menu-line block h-0.5 w-6 bg-white transition-all"></span>
      </div>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-0 z-40 flex flex-col justify-center bg-ink/95 opacity-0 backdrop-blur-xl transition-all duration-500 lg:hidden"
  >
    <nav class="flex flex-col items-center gap-8" aria-label="Mobile navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-2xl font-display text-white/90 transition-colors hover:text-gold"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={siteConfig.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 rounded-full bg-gold px-8 py-3 text-sm font-medium text-ink"
      >
        Let's Connect
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  let menuOpen = false;

  function updateHeader() {
    if (!header) return;
    const scrolled = window.scrollY > 60;
    header.classList.toggle('bg-ink/90', scrolled);
    header.classList.toggle('backdrop-blur-md', scrolled);
    header.classList.toggle('shadow-lg', scrolled);
  }

  function toggleMenu() {
    menuOpen = !menuOpen;
    menuBtn?.setAttribute('aria-expanded', String(menuOpen));
    mobileMenu?.classList.toggle('opacity-0', !menuOpen);
    mobileMenu?.classList.toggle('pointer-events-none', !menuOpen);
    document.body.style.overflow = menuOpen ? 'hidden' : '';
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();
  menuBtn?.addEventListener('click', toggleMenu);

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (menuOpen) toggleMenu();
    });
  });
</script>
