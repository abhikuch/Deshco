---
import { ourServices } from '../data/site';
---

<section id="services" class="section-padding bg-white">
  <div class="container-wide">
    <h2 class="heading-display mb-14 text-center text-4xl text-ink md:mb-16 md:text-5xl">
      Our Services
    </h2>

    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-10 lg:gap-y-14">
      {
        ourServices.map((service) => (
          <article class="text-center">
            <img
              src={service.icon}
              alt=""
              class="mx-auto mb-5 h-[72px] w-[72px] object-contain md:h-20 md:w-20"
              loading="lazy"
              width="80"
              height="80"
            />
            <h3 class="mb-2.5 text-[15px] font-semibold text-ink md:text-base">{service.title}</h3>
            <p class="mx-auto max-w-[240px] text-[13px] leading-relaxed text-ink-muted md:text-[14px]">
              {service.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
