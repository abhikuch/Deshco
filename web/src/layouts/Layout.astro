---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { siteConfig } from '../data/site';
import {
  absoluteUrl,
  buildPageGraph,
  seoDefaults,
  type BreadcrumbItem,
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  darkHeader?: boolean;
  image?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  darkHeader = false,
  image = seoDefaults.ogImage,
  noindex = false,
  breadcrumbs,
} = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const ogImageUrl = absoluteUrl(image);
const structuredData = buildPageGraph(breadcrumbs);
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="geo.region" content="AE-DU" />
    <meta name="geo.placename" content="Dubai" />

    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={seoDefaults.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(seoDefaults.ogImageWidth)} />
    <meta property="og:image:height" content={String(seoDefaults.ogImageHeight)} />
    <meta property="og:image:alt" content="Deshco Holiday Homes — luxury Dubai holiday home interior" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@deshcodubai" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Deshco Holiday Homes — luxury Dubai holiday home interior" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <title>{pageTitle}</title>
    <JsonLd data={structuredData} />
  </head>
  <body class:list={[{ 'bg-white': darkHeader }]}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
