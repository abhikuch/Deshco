---
import Layout from '../layouts/Layout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import HowItWorks from '../components/HowItWorks';
import AreasGrid from '../components/AreasGrid.astro';
import FoundersStrip from '../components/FoundersStrip.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import ContactForm from '../components/ContactForm';
import {
  siteConfig,
  heroContent,
  howItWorksSteps,
  whatsIncluded,
  whyDeshco,
  pageSeo,
} from '../data/site';
---

<Layout title={pageSeo.home.title} description={pageSeo.home.description}>
  <div class="pb-20 lg:pb-0">
    <!-- Hero -->
    <section data-hero class="relative flex min-h-[92svh] items-end overflow-hidden">
      <div class="absolute inset-0">
        <img
          src={heroContent.image}
          alt="Luxury Dubai holiday home interior"
          class="h-full w-full scale-105 object-cover"
          fetchpriority="high"
          width="1920"
          height="1080"
        />
        <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
      </div>

      <div class="relative z-10 w-full px-6 pb-16 pt-28 md:px-10 md:pb-24 lg:px-16">
        <div class="container-narrow max-w-2xl">
          <p class="eyebrow mb-5 text-gold-bright opacity-0 animate-[fadeUp_0.7s_ease-out_0.15s_forwards]">
            {heroContent.eyebrow}
          </p>
          <h1
            class="heading-display mb-5 text-balance text-[2.1rem] leading-[1.1] text-white opacity-0 animate-[fadeUp_0.7s_ease-out_0.3s_forwards] md:text-5xl lg:text-[3.1rem]"
          >
            {heroContent.headline}
          </h1>
          <p
            class="mb-9 max-w-lg text-[16px] leading-relaxed text-white/88 opacity-0 animate-[fadeUp_0.7s_ease-out_0.45s_forwards] md:text-[17px]"
          >
            {heroContent.subheadline}
          </p>
          <div class="flex flex-wrap gap-3 opacity-0 animate-[fadeUp_0.7s_ease-out_0.6s_forwards]">
            <a
              href="#contact"
              class="inline-flex items-center bg-gold-bright px-6 py-3 text-[13px] font-medium tracking-wide text-ink transition-colors hover:bg-white"
            >
              {heroContent.ctaPrimary}
            </a>
            <a
              href={siteConfig.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center border border-white/35 px-6 py-3 text-[13px] font-medium tracking-wide text-white transition-colors hover:border-white hover:bg-white/8"
            >
              {heroContent.ctaSecondary}
            </a>
          </div>
        </div>
      </div>
    </section>

    <TrustStrip />

    <!-- How it works -->
    <section id="how-it-works" class="section-padding bg-cream">
      <div class="container-wide">
        <div class="mb-14 max-w-xl">
          <p class="eyebrow mb-3">Process</p>
          <h2 class="heading-display text-4xl text-ink md:text-[2.75rem]">How it works</h2>
          <p class="mt-3 text-[15px] text-ink-muted">
            Three steps from first conversation to monthly payouts.
          </p>
        </div>
        <HowItWorks client:visible steps={howItWorksSteps} />
      </div>
    </section>

    <!-- What's included -->
    <section id="included" class="section-padding bg-white">
      <div class="container-wide">
        <div class="mb-12 max-w-xl">
          <p class="eyebrow mb-3">Full service</p>
          <h2 class="heading-display text-4xl text-ink md:text-[2.75rem]">What's included</h2>
          <p class="mt-3 text-[15px] text-ink-muted">
            Everything you need to run a compliant, profitable short-stay rental — handled for you.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          {
            whatsIncluded.map((item, index) => (
              <article class="border border-ink/8 bg-cream p-6 md:p-7">
                <span class="mb-4 block font-display text-3xl text-gold-muted tabular-nums">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="heading-display mb-2.5 text-xl text-ink md:text-2xl">{item.title}</h3>
                <p class="text-[15px] leading-relaxed text-ink-muted">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <AreasGrid />

    <!-- Why Deshco -->
    <section id="why-deshco" class="section-padding bg-ink text-white">
      <div class="container-wide">
        <div class="mb-12 grid gap-8 lg:grid-cols-2 lg:items-end">
          <div>
            <p class="eyebrow mb-3 text-gold-bright">Why Deshco</p>
            <h2 class="heading-display text-4xl text-white md:text-[2.75rem]">
              Boutique management for owners who want clarity
            </h2>
          </div>
          <p class="max-w-md text-[15px] text-white/72">
            Large operators optimise for volume. We optimise for transparency, compliance, and direct
            founder access — so your home is never just another listing.
          </p>
        </div>

        <div class="grid gap-px overflow-hidden border border-white/10 bg-white/10 sm:grid-cols-2">
          {
            whyDeshco.map((item) => (
              <div class="bg-ink-soft p-6 md:p-8">
                <h3 class="heading-display mb-2.5 text-xl text-white md:text-2xl">{item.title}</h3>
                <p class="text-[15px] leading-relaxed text-white/72">{item.description}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-12 flex flex-wrap items-center gap-4">
          <a
            href="/list-your-property"
            class="inline-flex items-center bg-gold-bright px-6 py-3 text-[13px] font-medium tracking-wide text-ink transition-colors hover:bg-white"
          >
            List your property
          </a>
          <a
            href="#contact"
            class="inline-flex items-center border border-white/30 px-6 py-3 text-[13px] font-medium tracking-wide text-white transition-colors hover:border-white"
          >
            Get a revenue estimate
          </a>
        </div>
      </div>
    </section>

    <FoundersStrip />

    <!-- Contact -->
    <section id="contact" class="section-padding bg-ink-soft">
      <div class="container-wide grid gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow mb-3 text-gold-bright">Get started</p>
          <h2 class="heading-display mb-4 text-4xl text-white md:text-[2.75rem]">
            Get your free revenue estimate
          </h2>
          <p class="mb-8 max-w-md text-[15px] leading-relaxed text-white/78">
            Tell us about your property. We'll review location, layout, and market demand — then send a
            tailored revenue estimate within 48 hours.
          </p>

          <dl class="space-y-3 text-sm">
            <div>
              <dt class="eyebrow mb-1 text-white/50">Phone</dt>
              <dd>
                <a href={siteConfig.phoneHref} class="text-white transition-colors hover:text-gold-bright">
                  {siteConfig.phone}
                </a>
              </dd>
            </div>
            <div>
              <dt class="eyebrow mb-1 text-white/50">WhatsApp</dt>
              <dd>
                <a
                  href={siteConfig.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white transition-colors hover:text-gold-bright"
                >
                  Message us directly
                </a>
              </dd>
            </div>
            <div>
              <dt class="eyebrow mb-1 text-white/50">Email</dt>
              <dd>
                <a
                  href={`mailto:${siteConfig.email}`}
                  class="text-white transition-colors hover:text-gold-bright"
                >
                  {siteConfig.email}
                </a>
              </dd>
            </div>
            <div>
              <dt class="eyebrow mb-1 text-white/50">Office</dt>
              <dd class="text-white/72">{siteConfig.address}</dd>
            </div>
          </dl>
        </div>

        <ContactForm client:visible />
      </div>
    </section>
  </div>

  <MobileCtaBar />
</Layout>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
