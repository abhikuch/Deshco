---
import Layout from '../layouts/Layout.astro';
import HowItWorks from '../components/HowItWorks';
import LocationGallery from '../components/LocationGallery';
import ContactForm from '../components/ContactForm';
import {
  siteConfig,
  heroContent,
  howItWorksSteps,
  locations,
  services,
  transparencyFeatures,
} from '../data/site';
---

<Layout>
  <section data-hero class="relative flex min-h-[100svh] items-end overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={heroContent.image}
        alt="Luxury Dubai holiday home interior"
        class="h-full w-full scale-105 object-cover"
        fetchpriority="high"
      />
      <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
    </div>

    <div class="relative z-10 w-full px-6 pb-16 pt-28 md:px-10 md:pb-24 lg:px-16">
      <div class="container-narrow max-w-2xl">
        <p class="eyebrow mb-5 text-gold-bright opacity-0 animate-[fadeUp_0.7s_ease-out_0.15s_forwards]">
          {heroContent.eyebrow}
        </p>
        <h1
          class="heading-display mb-5 text-balance text-[2.35rem] leading-[1.08] text-white opacity-0 animate-[fadeUp_0.7s_ease-out_0.3s_forwards] md:text-5xl lg:text-[3.25rem]"
        >
          {heroContent.headline}
        </h1>
        <p
          class="mb-9 max-w-lg text-[16px] leading-relaxed text-white/88 opacity-0 animate-[fadeUp_0.7s_ease-out_0.45s_forwards] md:text-[17px]"
        >
          {heroContent.subheadline}
        </p>
        <div class="flex flex-wrap gap-3 opacity-0 animate-[fadeUp_0.7s_ease-out_0.6s_forwards]">
          <a
            href="#contact"
            class="inline-flex items-center bg-gold-bright px-6 py-3 text-[13px] font-medium tracking-wide text-ink transition-colors hover:bg-white"
          >
            {heroContent.cta}
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center border border-white/35 px-6 py-3 text-[13px] font-medium tracking-wide text-white transition-colors hover:border-white hover:bg-white/8"
          >
            How it works
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="section-padding bg-cream">
    <div class="container-wide">
      <div class="mb-14 max-w-xl">
        <p class="eyebrow mb-3">Process</p>
        <h2 class="heading-display text-4xl text-ink md:text-[2.75rem]">How it works</h2>
      </div>
      <HowItWorks client:visible steps={howItWorksSteps} />
    </div>
  </section>

  <section class="section-padding bg-ink text-white">
    <div class="container-wide mb-10">
      <p class="eyebrow mb-3 text-gold-bright">Coverage</p>
      <h2 class="heading-display mb-3 text-4xl text-white md:text-[2.75rem]">
        Dubai's prime locations
      </h2>
      <p class="max-w-lg text-[15px] text-white/72">
        Access the finest homes in the most desirable tourist areas across the city.
      </p>
    </div>
    <LocationGallery client:visible locations={locations} />
  </section>

  <section id="services" class="section-padding bg-white">
    <div class="container-wide">
      <div class="mb-14 flex flex-col justify-between gap-5 border-b border-ink/10 pb-10 md:flex-row md:items-end">
        <div class="max-w-xl">
          <p class="eyebrow mb-3">What we do</p>
          <h2 class="heading-display text-4xl text-ink md:text-[2.75rem]">Our services</h2>
        </div>
        <p class="max-w-sm text-[15px] text-ink-muted">
          Full-stack holiday home management — from listing to guest turnover.
        </p>
      </div>

      <div class="divide-y divide-ink/10">
        {
          services.map((service, index) => (
            <article class="grid gap-3 py-8 md:grid-cols-[4rem_1fr_1.4fr] md:items-baseline md:gap-10 md:py-9">
              <span class="font-display text-2xl text-gold-muted tabular-nums">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="heading-display text-xl text-ink md:text-2xl">{service.title}</h3>
              <p class="text-[15px] leading-relaxed text-ink-muted">{service.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-padding bg-cream-dark">
    <div class="container-wide">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <p class="eyebrow mb-3">Trust</p>
          <h2 class="heading-display mb-4 text-4xl text-ink md:text-[2.75rem]">Owner-first transparency</h2>
          <p class="max-w-md text-[15px] text-ink-muted">
            No hidden fees, no surprises. Every payout, expense, and inspection documented.
          </p>
        </div>

        <div class="divide-y divide-ink/10 border-t border-ink/10">
          {
            transparencyFeatures.map((feature) => (
              <div class="py-8 first:pt-8">
                <h3 class="heading-display mb-2.5 text-xl text-ink md:text-2xl">{feature.title}</h3>
                <p class="text-[15px] leading-relaxed text-ink-muted">{feature.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="section-padding bg-ink-soft">
    <div class="container-wide grid gap-12 lg:grid-cols-2 lg:gap-16 lg:items-start">
      <div class="lg:sticky lg:top-28">
        <p class="eyebrow mb-3 text-gold-bright">Get started</p>
        <h2 class="heading-display mb-4 text-4xl text-white md:text-[2.75rem]">
          Ready to list your Dubai home?
        </h2>
        <p class="mb-8 max-w-md text-[15px] leading-relaxed text-white/78">
          Share your property details and we'll provide a tailored revenue estimate within 48 hours.
        </p>

        <dl class="space-y-3 text-sm">
          <div>
            <dt class="eyebrow mb-1 text-white/50">Phone</dt>
            <dd>
              <a href={siteConfig.phoneHref} class="text-white transition-colors hover:text-gold-bright">
                {siteConfig.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="eyebrow mb-1 text-white/50">Email</dt>
            <dd>
              <a
                href={`mailto:${siteConfig.email}`}
                class="text-white transition-colors hover:text-gold-bright"
              >
                {siteConfig.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="eyebrow mb-1 text-white/50">Office</dt>
            <dd class="text-white/72">{siteConfig.address}</dd>
          </div>
        </dl>
      </div>

      <ContactForm client:visible />
    </div>
  </section>
</Layout>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
