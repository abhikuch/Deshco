---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
import { partnerBenefits } from '../data/site';
---

<Layout
  title="List your property"
  description="Partner with Deshco Holiday Homes to turn your Dubai property into a high-performing holiday rental."
>
  <section data-hero class="relative flex min-h-[58vh] items-end overflow-hidden bg-ink-soft">
    <div class="absolute inset-0">
      <img
        src="/images/location-1.jpg"
        alt=""
        class="h-full w-full object-cover"
        loading="eager"
        aria-hidden="true"
      />
      <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
    </div>
    <div class="section-padding relative z-10 w-full pb-14 pt-28">
      <div class="container-narrow max-w-2xl">
        <p class="eyebrow mb-4 text-gold-bright">For homeowners</p>
        <h1 class="heading-display mb-5 text-4xl text-white md:text-5xl">
          Partner as a property owner
        </h1>
        <p class="text-[16px] leading-relaxed text-white/85 md:text-[17px]">
          Discover the true potential of your home with hassle-free holiday rentals — list with
          Deshco for the ultimate homeowner experience.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-cream">
    <div class="container-wide">
      <div class="mb-12 max-w-xl">
        <p class="eyebrow mb-3">Benefits</p>
        <h2 class="heading-display text-3xl text-ink md:text-4xl">Why partner with us</h2>
      </div>

      <div class="divide-y divide-ink/10 border-t border-ink/10">
        {
          partnerBenefits.map((benefit, index) => (
            <article class="grid gap-3 py-8 md:grid-cols-[4rem_1fr_1.4fr] md:items-baseline md:gap-10 md:py-9">
              <span class="font-display text-2xl text-gold-muted tabular-nums">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="heading-display text-xl text-ink md:text-2xl">{benefit.title}</h3>
              <p class="text-[15px] leading-relaxed text-ink-muted">{benefit.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="section-padding bg-ink-soft">
    <div class="container-wide grid gap-12 lg:grid-cols-2 lg:gap-16 lg:items-start">
      <div>
        <p class="eyebrow mb-3 text-gold-bright">Enquire</p>
        <h2 class="heading-display mb-4 text-3xl text-white md:text-4xl">
          Get your free revenue estimate
        </h2>
        <p class="max-w-md text-[15px] leading-relaxed text-white/78">
          Tell us about your property and we'll share a tailored projection of your holiday home's
          earning potential.
        </p>
      </div>
      <ContactForm client:visible />
    </div>
  </section>
</Layout>
