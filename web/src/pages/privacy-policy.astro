---
import Layout from '../layouts/Layout.astro';
import LegalPage from '../components/LegalPage.astro';
import { privacyPolicy } from '../data/legal';
import { pageSeo } from '../data/site';
---

<Layout
  title={pageSeo.privacy.title}
  description={pageSeo.privacy.description}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: privacyPolicy.title, path: '/privacy-policy' },
  ]}
>
  <LegalPage title={privacyPolicy.title} sections={privacyPolicy.sections} />
</Layout>
